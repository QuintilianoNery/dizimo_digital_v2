# ============================================================================
# CONFIGURAÇÕES SUPABASE - .env.local
# ============================================================================
# IMPORTANTE: VITE_SUPABASE_ANON_KEY deve ser a chave JWT (começa com eyJ...)
# Pegue em: Supabase Dashboard → Settings → API → Project API keys → anon public
#
# A VITE_SUPABASE_PUBLISHABLE_KEY (sb_publishable_...) é diferente da anon key!
# Para o @supabase/supabase-js você precisa da chave JWT anon.
# ============================================================================

VITE_SUPABASE_URL=https://moktjnacdztfjvezijnk.supabase.co

# Anon key (JWT format): Dashboard → Settings → API → anon public
# Exemplo: eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6...
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.SEU_ANON_KEY_AQUI

VITE_APP_ENV=development
